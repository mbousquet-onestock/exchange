# OneStock API connection (server-side only, never exposed to the browser).
# Leave ONESTOCK_SITE_ID / ONESTOCK_USER_ID / ONESTOCK_PASSWORD empty to run
# the portal on mock data (order id: DEMO-0001).
ONESTOCK_API_URL="https://api.onestock-retail.com"
ONESTOCK_SITE_ID=""
ONESTOCK_USER_ID=""
ONESTOCK_PASSWORD=""

# Product attribute (item "information" field) listing the item ids a product
# can be exchanged for, as an array or a comma separated string.
ONESTOCK_EXCHANGE_ATTRIBUTE="exchange_items"

# Exchange order creation
ONESTOCK_EXCHANGE_ORDER_PREFIX="EXC-"
ONESTOCK_EXCHANGE_ORDER_TYPE="exchange"
ONESTOCK_SALES_CHANNEL="returns_portal"
ONESTOCK_CURRENCY="GBP"
